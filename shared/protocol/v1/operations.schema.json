{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-harness.dev/protocol/v1/operations.schema.json",
  "title": "Universal Protocol v1 — Operations",
  "description": "Request/response operations. Each request carries a scope requirement; nodes enforce scope on every operation. Reconnect/replay is a first-class operation (session.replay) so clients recover missed events deterministically.",
  "$defs": {
    "ReconnectHandshake": {
      "type": "object",
      "required": ["deviceId", "lastEventId"],
      "additionalProperties": false,
      "properties": {
        "deviceId": { "$ref": "identifiers.schema.json#/$defs/DeviceId" },
        "lastEventId": { "type": ["integer", "null"], "minimum": 1, "description": "Client's last seen event id; null for a fresh client." },
        "capabilities": { "description": "Client-side capability declaration." }
      }
    },
    "TaskStartRequest": {
      "type": "object",
      "required": ["projectId"],
      "additionalProperties": false,
      "properties": {
        "projectId": { "$ref": "identifiers.schema.json#/$defs/ProjectId" },
        "sessionId": { "$ref": "identifiers.schema.json#/$defs/SessionId", "description": "Omit to create a new session; supply to resume." },
        "prompt": { "type": "string" },
        "provider": { "type": ["string", "null"], "description": "Provider profile name; null = node default." },
        "model": { "type": ["string", "null"] },
        "priority": { "enum": ["background", "normal", "urgent"], "default": "normal" }
      }
    },
    "TaskApproval": {
      "type": "object",
      "required": ["taskId", "approved"],
      "additionalProperties": false,
      "properties": {
        "taskId": { "$ref": "identifiers.schema.json#/$defs/TaskId" },
        "approved": { "type": "boolean" },
        "toolCallId": { "type": "string" }
      }
    },
    "FileWriteRequest": {
      "type": "object",
      "required": ["projectId", "path", "content"],
      "description": "Optimistic concurrency: the client supplies baseVersion/baseHash from its last read; mismatch yields CONFLICT with the current remote state.",
      "additionalProperties": false,
      "properties": {
        "projectId": { "$ref": "identifiers.schema.json#/$defs/ProjectId" },
        "path": { "type": "string" },
        "content": { "type": "string" },
        "baseHash": { "type": ["string", "null"] },
        "overwrite": { "type": "boolean", "default": false, "description": "Explicit overwrite; audited; still refuses to clobber a newer file silently." }
      }
    },
    "FileReadResponse": {
      "type": "object",
      "required": ["content", "version", "hash"],
      "additionalProperties": false,
      "properties": {
        "content": { "type": "string" },
        "version": { "type": "integer", "description": "Monotonic file version on the node." },
        "hash": { "type": "string", "description": "SHA-256 of content." },
        "modifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "TerminalRequest": {
      "type": "object",
      "required": ["projectId", "command"],
      "description": "Requires the 'terminal' scope. Command and session ids are audit-logged; output is redacted of known secret patterns. Bounded by timeoutMs.",
      "additionalProperties": false,
      "properties": {
        "projectId": { "$ref": "identifiers.schema.json#/$defs/ProjectId" },
        "command": { "type": "string" },
        "cwd": { "type": ["string", "null"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Sanitized; never contains credentials from the vault." }
      }
    },
    "DiagnosticsResult": {
      "type": "object",
      "required": ["checks"],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/DiagnosticRecord" }
        }
      }
    },
    "DiagnosticRecord": {
      "type": "object",
      "required": ["id", "severity", "component", "condition", "recommendedAction"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Stable diagnostic id, e.g. 'runtime.missing'." },
        "severity": { "enum": ["ok", "warn", "fail"] },
        "component": { "type": "string" },
        "condition": { "type": "string", "description": "Human-readable finding. Redacted of secrets." },
        "evidence": { "type": ["string", "null"] },
        "recommendedAction": { "type": "string", "description": "Safe action text, possibly a repair command." },
        "autoRepairSafe": { "type": "boolean" }
      }
    },
    "UpdateApplyRequest": {
      "type": "object",
      "required": ["channel"],
      "additionalProperties": false,
      "properties": {
        "channel": { "enum": ["universal-harness", "harness", "runtime", "toolchain", "rootfs"] },
        "version": { "type": ["string", "null"], "description": "Target version; null = latest verified manifest entry." }
      }
    },
    "ReplayResponse": {
      "type": "object",
      "required": ["events", "truncated", "unavailable"],
      "description": "Response to session.replay with lastEventId. Returns durable events strictly after the cursor. If the durable store cannot serve beyond the cursor (retention exceeded, corrupted index, fresh install), the node sets unavailable=true and returns an authoritative RecoverySnapshot instead; clients reconcile from it and must never infer task state from the mere absence of events.",
      "additionalProperties": false,
      "properties": {
        "events": { "type": "array", "items": { "description": "Envelopes with eventId; durable events only." } },
        "truncated": { "type": "boolean" },
        "nextCursor": { "type": ["integer", "null"] },
        "unavailable": {
          "type": "boolean",
          "description": "true when the node cannot serve events beyond the given cursor. Clients must then rely on the provided RecoverySnapshot."
        },
        "snapshot": { "$ref": "#/$defs/RecoverySnapshot" }
      }
    },
    "RecoverySnapshot": {
      "type": "object",
      "required": ["nodeId", "generatedAt", "tasks", "sessions"],
      "description": "Authoritative point-in-time node state used when event replay is unavailable or after ambiguous crash windows. Doubles as the reconciliation baseline. Contains only task/session metadata, never conversation content.",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "$ref": "identifiers.schema.json#/$defs/NodeId" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["taskId", "state"],
            "additionalProperties": false,
            "properties": {
              "taskId": { "$ref": "identifiers.schema.json#/$defs/TaskId" },
              "state": { "enum": ["queued", "starting", "running", "recovering", "waiting", "completed", "failed", "cancelled"] },
              "sessionId": { "$ref": "identifiers.schema.json#/$defs/SessionId" },
              "lastEventId": { "type": ["integer", "null"], "minimum": 1 },
              "recovered": { "type": "boolean", "description": "true if the state was re-derived by the supervisor after an abnormal termination rather than read from a persisted record." }
            }
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sessionId"],
            "additionalProperties": false,
            "properties": {
              "sessionId": { "$ref": "identifiers.schema.json#/$defs/SessionId" },
              "projectId": { "$ref": "identifiers.schema.json#/$defs/ProjectId" }
            }
          }
        }
      }
    }
  }
}
