{
  "name": "universal-harness",
  "version": "1.0.0",
  "description": "Portable desktop execution layer around the official DeepSeek Harness (dsh). Windows x64 / Linux x64.",
  "private": true,
  "type": "module",
  "bin": {
    "uh": "bin/uh.mjs"
  },
  "scripts": {
    "test": "node --test tests/",
    "doctor": "node bin/uh.mjs doctor",
    "lint": "eslint core bin scripts tests",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check core bin scripts tests --ignore-path .prettierignore"
  },
  "engines": {
    "node": ">=20.10"
  },
  "files": [
    "bin/",
    "core/",
    "manifests/",
    "shared/",
    "tests/"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
